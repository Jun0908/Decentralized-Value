{
  "name": "frontier-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A protocol for rewarding artifacts that expand reproducible Pareto frontiers.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "benchmark:orderbook": "tsx benchmarks/evm-orderbook/src/run.ts",
    "benchmark:rescue-room": "tsx scripts/benchmark-rescue-room.ts",
    "smoke:rescue-room-agent": "tsx scripts/smoke-rescue-room-agent.ts",
    "rescue:operator": "tsx scripts/rescue-operator.ts",
    "rescue:submission-demo": "tsx scripts/rescue-submission-demo.ts",
    "verify:rescue:submission-api": "tsx scripts/verify-rescue-submission-api.ts",
    "verify:rescue:submission-replay": "tsx scripts/verify-rescue-submission-replay.ts",
    "verify:rescue:submission-ui": "tsx scripts/verify-rescue-submission-ui.ts",
    "rescue:operator:server": "tsx scripts/rescue-operator-server.ts",
    "rescue:jobs": "tsx scripts/rescue-jobs-cli.ts",
    "rescue:deploy:prepare": "tsx scripts/deploy-rescue-operator.ts",
    "rescue:evidence:verify": "tsx scripts/export-rescue-service-evidence.ts",
    "verify:rescue:deployment-local": "tsx scripts/verify-rescue-deployment-local.ts",
    "verify:rescue:operator-ui": "tsx scripts/verify-rescue-operator-ui.ts",
    "verify:rescue-room-ui": "tsx scripts/verify-rescue-room-ui.ts",
    "benchmark:secret-gate": "tsx scripts/benchmark-secret-gate.ts",
    "build": "pnpm build:tooling && pnpm build:contracts && pnpm --filter @frontier/web build",
    "build:tooling": "pnpm --filter @frontier/shared build && pnpm --filter @frontier/sdk build && pnpm --filter @frontier/cli build",
    "build:contracts": "forge build --root packages/contracts",
    "ci": "pnpm build:tooling && pnpm env:check && pnpm lint && pnpm format:check && pnpm contracts:cli:check && pnpm contracts:sdk:check && pnpm typecheck && pnpm test && pnpm verify:rescue-envelope && pnpm benchmark:orderbook && pnpm build && pnpm verify:cli && pnpm verify:packages",
    "dev": "pnpm --filter @frontier/web dev",
    "deploy:sepolia": "pnpm --dir packages/contracts exec forge script script/Deploy.s.sol:Deploy --rpc-url sepolia --broadcast --verify",
    "deploy:secret-gate:sepolia": "pnpm --dir packages/contracts exec forge script script/DeploySecretGate.s.sol:DeploySecretGate --rpc-url sepolia --broadcast --verify",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "deploy:reward-demo": "tsx scripts/deploy-reward-demo.ts",
    "deploy:plan5-reward": "tsx scripts/deploy-plan5-reward.ts",
    "deploy:ocean-commons:sepolia": "pnpm --dir packages/contracts exec forge script script/DeployOceanCommons.s.sol:DeployOceanCommons --rpc-url sepolia --broadcast --verify",
    "deploy:rescue-payments:sepolia": "pnpm --dir packages/contracts exec forge script script/DeployRescuePayments.s.sol:DeployRescuePayments --rpc-url sepolia --broadcast --verify",
    "env:check": "tsx scripts/validate-env.ts",
    "artifacts:secret-gate": "tsx scripts/fetch-secret-gate-artifacts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && forge fmt --root packages/contracts --check",
    "lint:fix": "eslint . --fix",
    "security:scan": "tsx scripts/secret-scan.ts",
    "test": "pnpm test:ts && pnpm test:contracts",
    "test:contracts": "forge test --root packages/contracts",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts:cli": "tsx scripts/export-cli-contract.ts",
    "contracts:cli:check": "tsx scripts/export-cli-contract.ts --check",
    "contracts:sdk": "tsx scripts/sync-contract.ts",
    "contracts:sdk:check": "tsx scripts/sync-contract.ts --check",
    "verify:packages": "tsx scripts/verify-package.ts",
    "verify:rescue-envelope": "tsx scripts/verify-rescue-envelope.ts",
    "verify:cli": "tsx scripts/verify-cli-stack.ts",
    "verify:secret-gate": "tsx scripts/verify-secret-gate.ts"
  },
  "devDependencies": {
    "@frontier/cli": "workspace:*",
    "@frontier/sdk": "workspace:*",
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "solc": "0.8.30",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "viem": "2.56.3",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
