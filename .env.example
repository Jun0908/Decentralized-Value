# Core runtime
NODE_ENV=development
NEXT_PUBLIC_CHAIN_ID=11155111

# Local services
API_PORT=3001
RUNNER_PORT=3002
NEXT_PUBLIC_FRONTIER_API_URL=http://localhost:3001

# Ethereum Sepolia (provide locally; do not commit credentials)
SEPOLIA_RPC_URL=

# ENSv2 (resolve through the chain-aware client; do not pin the Universal Resolver proxy)
ENS_PARENT_NAME=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Bazantic (copy endpointUrl from `baz gateway list --json`; never construct it manually)
BAZANTIC_GATEWAY_URL=

# Ledger
LEDGER_SIGNING_MODE=
LEDGER_DERIVATION_PATH=
