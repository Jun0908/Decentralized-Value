# Core runtime
NODE_ENV=development
NEXT_PUBLIC_CHAIN_ID=11155111

# Local services
API_PORT=3001
RUNNER_PORT=3002
RUNNER_PUBLIC_URL=
NEXT_PUBLIC_FRONTIER_API_URL=http://localhost:3001

# Ethereum Sepolia (provide locally; do not commit credentials)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
ETHERSCAN_API_KEY=

# ENSv2 (resolve through the chain-aware client; do not pin the Universal Resolver proxy)
ENS_PARENT_NAME=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Bazantic (copy endpointUrl from `baz gateway list --json`; never construct it manually)
BAZANTIC_GATEWAY_URL=
BAZANTIC_SERVICE_ID=
BAZANTIC_RECIPE_ID=

# Ledger
LEDGER_SIGNING_MODE=
LEDGER_DERIVATION_PATH=
LEDGER_RING_FILE=
LEDGER_RING_KEY=frontier-runner-submit

# Live evidence (written only after successful external operations)
CHALLENGE_REGISTRY_ADDRESS=
ARTIFACT_REGISTRY_ADDRESS=
ATTESTATION_ADDRESS=
PARETO_SETTLEMENT_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_URL=
