# Configuration template — never put real credentials in this tracked file.
# Blank means "not configured", NOT "unused". Fill only the features you enable.
# Deterministic practice needs no AI key; live AI requires server-side configuration.
# Existing .env values must not be overwritten by copying this template over them.
# Reference: Docs/ENVIRONMENT.md. Vercel Production is configured separately.

# 1. Local runtime defaults (do not force NODE_ENV=development on Vercel)
NODE_ENV=development
NEXT_PUBLIC_CHAIN_ID=11155111
API_PORT=3001
RUNNER_PORT=3002

# 2. Real AI — required for Rescue Commander / Ocean model-backed seasons
# Server-only secret. Never rename this to NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
# Optional overrides: leave these COMMENTED to use the existing runtime defaults.
# An active OPENAI_MODEL= empty string can bypass Ocean's nullish default.
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1
# Rescue's controlled model is fixed in code; OPENAI_MODEL is not its model selector.

# 3. Account UX and server-side identity verification (configure as a pair)
# Only the app ID is public; do not expose backend credentials through NEXT_PUBLIC_.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# 4. Durable Web storage — required for production protected/one-time-use flows
# Supply a matching URL/token pair from one Redis resource.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Existing adapters also accept these aliases if the corresponding KV value is absent.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 5. CLI browser authorization — exact trusted Web origin outside local development
# This is not inferred from request Host headers; it is separate from an API base URL.
FRONTIER_CLI_ORIGIN=

# 6. Sepolia operator/deployment tools — not required just to browse or practice
# Use only test-network credentials; local deployer keys do not belong in public Web.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Optional explorer tooling placeholder; no current authored runtime consumer found.
ETHERSCAN_API_KEY=

# 7. Optional ENS/Bazantic discovery and diagnostic metadata
# ENS runner discovery also needs SEPOLIA_RPC_URL; a name alone is not a working runner.
ENS_PARENT_NAME=
# Copy endpointUrl from the actual gateway response; do not construct one.
BAZANTIC_GATEWAY_URL=
BAZANTIC_SERVICE_ID=
# Legacy demo-check metadata; MCP usage does not by itself require this variable.
BAZANTIC_RECIPE_ID=

# 8. Participant reward relayer — DISABLED by default; unrelated to practice credits
# Enabling this permits real Sepolia reward transactions once all checks pass.
# Use a dedicated capped relayer, never the broad deployer key.
PLAN5_SETTLEMENT_ENABLED=false
PLAN5_RELAYER_PRIVATE_KEY=
PLAN5_REWARD_POOL_ADDRESS=
PLAN5_DEMO_TOKEN_ADDRESS=
PLAN5_MAX_REWARD_CREDITS=10000

# 9. Optional verified reward-display evidence — public values, never credentials
# Populate only from the matching verified deployment and transactions.
# These are not Rescue service-payment settings and do not execute a transfer.
NEXT_PUBLIC_REWARD_POOL_ADDRESS=
NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=
NEXT_PUBLIC_ALLOCATION_TX_HASH=
NEXT_PUBLIC_SETTLEMENT_TX_HASH=
NEXT_PUBLIC_SETTLEMENT_BLOCK_NUMBER=
NEXT_PUBLIC_RESULT_ROOT=
NEXT_PUBLIC_REWARD_RECIPIENT=
NEXT_PUBLIC_REWARD_AMOUNT=
NEXT_PUBLIC_REWARD_BALANCE_BEFORE=
NEXT_PUBLIC_REWARD_BALANCE_AFTER=

# 10. Legacy standalone-runner / orderbook deployment checks — normally left blank
# Do not substitute newer Rescue/Ocean contracts just to make a diagnostic pass.
RUNNER_PUBLIC_URL=
CHALLENGE_REGISTRY_ADDRESS=
ARTIFACT_REGISTRY_ADDRESS=
ATTESTATION_ADDRESS=
PARETO_SETTLEMENT_ADDRESS=
# Public URL for legacy demo-check diagnostics, not application routing configuration.
NEXT_PUBLIC_DEPLOYMENT_URL=

# 11. Optional Ledger integration — not required for Web practice or AI inference
# Keep signing disabled unless explicitly setting up that separate workflow.
# LEDGER_SIGNING_MODE=
# ALLOW_INSECURE_LOCAL_SIGNER=false
# Reserved schema fields; no direct runtime consumer found beyond schema:
# LEDGER_DERIVATION_PATH=
# LEDGER_RING_FILE=
# LEDGER_RING_KEY=
# NEXT_PUBLIC_FRONTIER_API_URL is not listed: no current app consumer was found.
