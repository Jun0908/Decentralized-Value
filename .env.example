# Core runtime
NODE_ENV=development
NEXT_PUBLIC_CHAIN_ID=11155111

# Local services
API_PORT=3001
RUNNER_PORT=3002
RUNNER_PUBLIC_URL=

# Ethereum Sepolia (provide locally; do not commit credentials)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
ETHERSCAN_API_KEY=

# ENSv2 (resolve through the chain-aware client; do not pin the Universal Resolver proxy)
ENS_PARENT_NAME=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Bazantic (copy endpointUrl from `baz gateway list --json`; never construct it manually)
BAZANTIC_GATEWAY_URL=
BAZANTIC_SERVICE_ID=
BAZANTIC_RECIPE_ID=

# Live evidence (written only after successful external operations)
CHALLENGE_REGISTRY_ADDRESS=
ARTIFACT_REGISTRY_ADDRESS=
ATTESTATION_ADDRESS=
PARETO_SETTLEMENT_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_URL=

# Optional verified Sepolia reward evidence (public values only)
NEXT_PUBLIC_REWARD_POOL_ADDRESS=
NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=
NEXT_PUBLIC_ALLOCATION_TX_HASH=
NEXT_PUBLIC_SETTLEMENT_TX_HASH=
NEXT_PUBLIC_SETTLEMENT_BLOCK_NUMBER=
NEXT_PUBLIC_RESULT_ROOT=
NEXT_PUBLIC_REWARD_RECIPIENT=
NEXT_PUBLIC_REWARD_AMOUNT=
NEXT_PUBLIC_REWARD_BALANCE_BEFORE=
NEXT_PUBLIC_REWARD_BALANCE_AFTER=
